{
    "initializeCommand": "test -f .devcontainer/docker-compose.local.yaml || cp .devcontainer/docker-compose.local.template.yaml .devcontainer/docker-compose.local.yaml",
    "dockerComposeFile": [
        "../docker-compose.yaml",
        "docker-compose.local.yaml"
    ],
    "service": "race_stack",
    "runServices": [
        "race_stack",
        "zenoh_router"
    ],
    "workspaceFolder": "/ws",
    "remoteUser": "race_crew",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cpptools-extension-pack",
                "ms-python.python",
                "Ranch-Hand-Robotics.rde-ros-2"
            ],
            "settings": {
                "ROS2.distro": "humble",
                "python.defaultInterpreterPath": "/usr/bin/python3",
                "python.autoComplete.extraPaths": [
                    "/opt/ros/humble/lib/python3.10/site-packages",
                    "/opt/ros/humble/local/lib/python3.10/dist-packages"
                ],
                "python.analysis.extraPaths": [
                    "/opt/ros/humble/lib/python3.10/site-packages",
                    "/opt/ros/humble/local/lib/python3.10/dist-packages"
                ],
                "python.envFile": "${workspaceFolder}/src/race_stack/.env",
                "search.exclude": {
                    "**/build": true,
                    "**/install": true,
                    "**/log": true
                }
            }
        }
    },
    "postCreateCommand": "bash /ws/src/race_stack/.install_utils/post_create_command.sh"
}
