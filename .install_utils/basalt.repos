# Sources for the basalt VIO workspace built in .devcontainer/Dockerfile.vio.
# Pinned to exact commits so image builds are reproducible; bump a hash to update.
# basalt must come after basalt_wrapper, since it is cloned into its folder.
repositories:
  src/basalt_ros:
    type: git
    url: https://github.com/ForzaETH/basalt_ros.git
    version: fc5439c151fbf782fadc64d96ee7c4951fb9585f
  src/basalt_vio_msgs:
    type: git
    url: https://github.com/berndpfrommer/basalt_vio_msgs.git
    version: 8ed58cfb9da18df3fcea8609208375340d0ee1d9
  src/basalt_wrapper:
    type: git
    url: https://github.com/berndpfrommer/basalt_wrapper.git
    version: 5b261f65904de18e10c2bb2a858a82d88ae87cf9
  # ForzaETH fork, branch forzaeth/vio-only: VIO library only, no tools/GUI/tests
  src/basalt_wrapper/basalt:
    type: git
    url: https://github.com/ForzaETH/basalt.git
    version: 8655e43c7c0d027f44874e56bfdbf49eab7d6c6a
