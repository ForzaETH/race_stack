
# Source ROS, the workspace and basalt (separate workspace, only built with USE_VIO=true)
source /opt/ros/$ROS_DISTRO/setup.bash
[ -f /ws/install/setup.bash ] && source /ws/install/setup.bash
[ -f /opt/basalt_ws/install/setup.bash ] && source /opt/basalt_ws/install/setup.bash

# Display of the current session
[ -s /tmp/.docker_xauth/display ] && export DISPLAY=$(cat /tmp/.docker_xauth/display)
export XDG_RUNTIME_DIR=/tmp/runtime-$(id -u) && mkdir -p -m 0700 $XDG_RUNTIME_DIR

# Git branch in the prompt
source /usr/lib/git-core/git-sh-prompt
PS1="\[\e[01;32m\]\u@\h\[\e[00m\]:\[\e[01;34m\]\w\[\e[00m\]\$(__git_ps1 \" (%s)\")\$ "

# Aliases for shortcuts
alias scripz='cd /ws/src/race_stack/stack_master/scripts'
