#bashrc extension for git
source /usr/share/bash-completion/completions/git
parse_git_branch() {
    git branch 2> /dev/null | sed -e '/^[^*]/d' -e 's/* \(.*\)/[\1]/'
}

if [[ $TERM == *"color"* ]]; then
    # muted tones: sage user@docker-<car>, steel blue folder, bold soft red git branch
    PS1="${debian_chroot:+($debian_chroot)}\[\033[1;38;5;108m\]\u@docker-\${RACECAR_VERSION:-unknown}\[\033[0m\]:\[\033[38;5;110m\]\W\[\033[1;38;5;167m\]\$(parse_git_branch)\[\033[0m\]\$ "
fi
