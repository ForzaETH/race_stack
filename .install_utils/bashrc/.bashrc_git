#bashrc extension for git
source /usr/share/bash-completion/completions/git
parse_git_branch() {
    git branch 2> /dev/null | sed -e '/^[^*]/d' -e 's/* \(.*\)/[\1]/'
}

if [[ $TERM == *"color"* ]]; then
    # docker tag + magenta/cyan so the container shell differs from the host's green/blue
    PS1="${debian_chroot:+($debian_chroot)}\[\033[01;30;43m\][docker]\[\033[00m\] \[\033[01;35m\]\u@\h\[\033[00m\]:\[\033[01;36m\]\w\[\e[91m\]\$(parse_git_branch)\[\e[00m\]$ "
fi
