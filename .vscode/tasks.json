{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Workspace",
            "detail": "Builds all packages in the workspace natively",
            "type": "shell",
            "command": "cd /ws && colcon build --symlink-install --cmake-args -DCMAKE_BUILD_TYPE=${input:build-type} -DCMAKE_EXPORT_COMPILE_COMMANDS=On",
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Build Target",
            "detail": "Builds specific packages in the workspace",
            "type": "shell",
            "command": "cd /ws && colcon build --packages-up-to ${input:packages} --symlink-install --cmake-args -DCMAKE_BUILD_TYPE=${input:build-type} -DCMAKE_EXPORT_COMPILE_COMMANDS=On",
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "Clean Workspace",
            "detail": "Wipes the build, install, and log directories",
            "type": "shell",
            "command": "cd /ws && colcon clean workspace --yes",
            "problemMatcher": []
        },
        {
            "label": "Clean Target",
            "detail": "Cleans specific packages",
            "type": "shell",
            "command": "cd /ws && colcon clean packages --packages-up-to ${input:packages} --yes",
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "packages",
            "type": "promptString",
            "description": "Name of package(s) to target"
        },
        {
            "id": "build-type",
            "type": "pickString",
            "description": "Choose CMake build type",
            "options": [
                "Debug",
                "Release",
                "RelWithDebInfo"
            ],
            "default": "Release"
        }
    ]
}
