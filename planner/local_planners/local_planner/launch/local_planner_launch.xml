<launch>
    <arg name="sim_opp" default="False" description="True to remap topics to the simulated opponent ones" />
    <group>
        <set_remap from="/state" to="/opp_racecar/state" if="$(var sim_opp)" />
        <set_remap from="/local_waypoints" to="/opp_racecar/local_waypoints" if="$(var sim_opp)" />
        <set_remap from="/local_waypoints/markers" to="/opp_racecar/local_waypoints/markers" if="$(var sim_opp)" />
        <node pkg="local_planner" name="local_planner" exec="local_planner" output="screen">
            <param from="$(find-pkg-share stack_master)/config/local_planner_params.yaml"/>
        </node>
    </group>
</launch>
