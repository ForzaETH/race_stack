<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>prediction</name>
  <version>0.0.0</version>
  <description>Predicts the opponent raceline using Gaussian Processes</description>
  <maintainer email="contact@forzaeth.ch">ForzaETH</maintainer>
  <license>MIT</license>

  <!-- Parameter modules are generated from config/*_parameters.yaml at build time and import it at runtime -->
  <depend>generate_parameter_library_py</depend>

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>f110_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>stack_master</exec_depend>

  <test_depend>ament_copyright</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
