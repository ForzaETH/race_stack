<!-- -*- mode: XML -*- -->
<launch>
  <arg name="racecar" default="$(env RACECAR_VERSION)" description="'SIM' for the simulator, or the car name ('NUCx')" />
  <arg name="floor" default="dubi" />
  <arg name="map" default="latest" description="Map folder name in $MAPS_DIR" />

  <let name="sim" value="$(eval &quot;'$(var racecar)' == 'SIM'&quot;)" />
  <let name="map_path" value="$(env MAPS_DIR)/$(var map)" />
  <!-- ego TF frames: the simulator prefixes them with its ego_namespace (config/SIM/sim.yaml) -->
  <let name="base_frame" value="$(eval &quot;'car_state/base_link' if $(var sim) else 'base_link'&quot;)" />
  <let name="laser_frame" value="$(eval &quot;'car_state/laser' if $(var sim) else 'laser'&quot;)" />

  <!-- launch simulator -->
  <group if="$(var sim)">
    <include file="$(find-pkg-share f1tenth_gym_ros)/launch/gym_bridge_launch.py">
      <arg name="map_yaml_path" value="$(var map_path)/$(var map).yaml" />
    </include>
    <!-- only needed in sim -->
    <include file="$(find-pkg-share frenet_odom_republisher)/launch/frenet_odom_republisher_launch.xml" />
    
    <node pkg="tf2_ros" exec="static_transform_publisher" name="static_map_to_odom"
          args="--frame-id map --child-frame-id odom" />
  </group>

  <!-- launch real car system -->
  <group unless="$(var sim)">
    <!-- launch teleop stack -->
    <include file="$(find-pkg-share stack_master)/launch/teleop_launch.xml">
      <arg name="racecar_version" value="$(var racecar)" />
    </include>

    <!-- launch SE -->
    <include file="$(find-pkg-share state_estimation)/launch/state_estimation_launch.xml">
      <arg name="racecar_version" value="$(var racecar)" />
      <arg name="mapping_bool" value="False" />
      <arg name="map_name" value="$(var map)" />
      <arg name="frenet_bool" value="True" />
    </include>
  </group>

  <!-- launch global parameter node -->
  <node pkg="stack_master" name="global_parameters" exec="global_parameter_node">
    <param name="racecar_version" value="$(var racecar)" />
    <param name="floor" value="$(var floor)" />
    <param name="sim" value="$(var sim)" />
    <param name="base_frame" value="$(var base_frame)" />
    <param name="laser_frame" value="$(var laser_frame)" />
    <param name="map_path" value="$(var map_path)" />
    <!-- Fails with l1 params for some reason
    <param from="$(find-pkg-share stack_master)/config/$(var racecar)/l1_params.yaml" /> -->
    <param name="use_sim_time" value="$(var sim)" />
  </node>

  <!-- launch global trajectory republisher via included launch -->
  <include file="$(find-pkg-share global_planner)/launch/global_trajectory_publisher_launch.xml">
    <arg name="map_path" value="$(var map_path)" />
  </include>


  <!-- launch sector tuner -->
  <node pkg="sector_tuner" name="sector_tuner" exec="sector_tuner">
    <param from="$(var map_path)/speed_scaling.yaml" />
  </node>

  <!-- launch ot sector tuner -->
  <node pkg="sector_tuner" name="ot_interpolator" exec="ot_interpolator">
    <param from="$(var map_path)/ot_sectors.yaml" />
  </node>

  <!-- launch lap analyser -->
  <node pkg="lap_analyser" name="lap_analyser" exec="lap_analyser" output="screen" />

</launch>
