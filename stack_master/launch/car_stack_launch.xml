<launch>
  <arg name="ns" description="Car namespace, e.g. ego / opp" />
  <arg name="planner" default="spliner" description="spliner / ibr / none" />
  <arg name="ctrl_algo" default="PP" description="MAP / PP" />
  <arg name="map_name" default="latest" />
  <arg name="opponent_source" default="perception" description="gt / perception" />
  <arg name="opp_ns" default="" description="namespace of the other car, used when opponent_source=gt" />
  <arg name="speed_scale" default="1.0" />
  <arg name="rival_speed_scale" default="1.0" />
  <arg name="record_path" default="" />
  <arg name="n_game_iterations" default="4" />
  <arg name="speed_limit" default="0.0" />
  <arg name="rival_speed_limit" default="0.0" />
  <arg name="time_scale" default="1.0" />




  


  <group>
    <push-ros-namespace namespace="$(var ns)" />

    <!-- per-car: car_state/odom -> car_state/frenet/odom -->
    <include file="$(find-pkg-share frenet_odom_republisher)/launch/frenet_odom_republisher_launch.xml" />

    <!-- per-car: state_machine now calls the relative 'ot_interpolator/get_parameters' -->
    <node pkg="sector_tuner" name="ot_interpolator" exec="ot_interpolator">
      <param name="map_name" value="$(var map_name)" />
      <param from="$(find-pkg-share stack_master)/maps/$(var map_name)/ot_sectors.yaml" />
    </node>

    <include file="$(find-pkg-share controller)/launch/controller_launch.xml">
      <arg name="mode" value="$(var ctrl_algo)" />
      <arg name="speed_limit" value="$(var speed_limit)" />
      <arg name="time_scale" value="$(var time_scale)" />
    </include>

    <group unless="$(eval '\'$(var planner)\' in [\'gb\', \'ibr\',  \'mpc\']')">
      <include file="$(find-pkg-share state_machine)/launch/state_machine_launch.xml">
        <arg name="mode" value="head_to_head" />
      </include>
    </group>
    <group if="$(eval '\'$(var planner)\' == \'gb\'')">
      <!-- named state_machine: the controller queries state_machine/rate_hz at startup -->
      <node pkg="gb_follower" exec="gb_follower" name="state_machine" output="screen">
        <param name="speed_scale" value="$(var speed_scale)" />
      </node>
    </group>

    <!-- opponent info: real perception -->
    <group if="$(eval '\'$(var opponent_source)\' == \'perception\'')">
      <include file="$(find-pkg-share perception)/launch/perception_launch.xml">
        <arg name="param_file" value="$(find-pkg-share stack_master)/config/opponent_tracker_params.yaml" />
      </include>
    </group>

    <!-- opponent info: ground truth from the other car's odom -->
    <group if="$(eval '\'$(var opponent_source)\' == \'gt\'')">
      <node pkg="perception" exec="gt_opponent" name="gt_opponent" output="screen">
        <param name="opp_ns" value="$(var opp_ns)" />
      </node>
    </group>

    <group if="$(eval '\'$(var planner)\' == \'spliner\'')">
      <include file="$(find-pkg-share spline_planner)/launch/spline_planner_launch.xml" />
    </group>
    <group if="$(eval '\'$(var planner)\' in [\'ibr\', \'mpc\']')">
      <node pkg="ibr_planner" exec="ibr_planner" name="state_machine" output="screen">
        <param name="record_path" value="$(var record_path)" />
        <param name="n_game_iterations" value="$(var n_game_iterations)" />
        <param name="opp_ns" value="$(var opp_ns)" />
        <param name="rate_hz" value="$(eval '10.0 * $(var time_scale)')" />
        <param name="speed_scale" value="$(var speed_scale)" />
        <param name="opp_speed_scale" value="$(var rival_speed_scale)" />
        <param name="speed_limit" value="$(var speed_limit)" />
        <param name="rival_speed_limit" value="$(var rival_speed_limit)" />
        <param name="naive_mpc" value="$(eval '\'$(var planner)\' == \'mpc\'')" />


      </node>
    </group>
  </group>
</launch>
