<!-- -*- mode: XML -*- -->
<launch>
    <arg name="racecar_version" default="$(env RACECAR_VERSION)" />
    <arg name="floor" default="dubi" />
    <arg name="map_name" description="Name of the map to be created" default="latest"/>
    <let name="sensors_config" value="$(find-pkg-share stack_master)/config/sensors.yaml" />
    <let name="mux_config" value="$(find-pkg-share stack_master)/config/mux.yaml" />
    <let name="joy_teleop_config" value="$(find-pkg-share stack_master)/config/$(var racecar_version)/joy_teleop.yaml" />
    <let name="vesc_config" value="$(find-pkg-share stack_master)/config/$(var racecar_version)/vesc.yaml" />

    <let name="map_path" value="$(env MAPS_DIR)/$(var map_name)" />

    <!-- ON PHYSICAL SYSTEM -->
    <node pkg="global_planner" exec="mapping_node" name="mapping_node" output="screen" emulate_tty="true">
        <param from="$(find-pkg-share stack_master)/config/global_planner/mapping.yaml" />
        <param name="map_path" value="$(var map_path)" />
    </node>

    <!-- launch teleop -->
    <include file="$(find-pkg-share f1tenth_stack)/launch/bringup_launch.py">
        <arg name="joy_teleop_config" value="$(var joy_teleop_config)" />
        <arg name="vesc_config" value="$(var vesc_config)" />
        <arg name="sensors_config" value="$(var sensors_config)" />
        <arg name="mux_config" value="$(var mux_config)" />
    </include>

    <!-- launch SE -->
    <include file="$(find-pkg-share state_estimation)/launch/state_estimation_launch.xml">
        <arg name="racecar_version" value="$(var racecar_version)" />
        <arg name="mapping_bool" value="True" />
        <arg name="map_name" value="$(var map_name)" />
        <arg name="frenet_bool" value="False" />
        <arg name="use_sim_time" value="True" />
    </include>

    <!-- launch global parameter node -->
    <node pkg="stack_master" name="global_parameters" exec="global_parameter_node">
        <param name="racecar_version" value="$(var racecar_version)" />
        <param name="floor" value="$(var floor)" />
        <param name="sim" value="false" />
        <param name="map_path" value="$(var map_path)" />
        <param name="use_sim_time" value="false" />
    </node>




</launch>