<!-- -*- mode: XML -*- -->
<launch>
    <arg name="racecar_version" default="$(env RACECAR_VERSION)" />
    <arg name="floor" default="dubi" />
    <arg name="map" description="Name of the map to be created at $MAPS_DIR/map" default="latest"/>
    <arg name="use_vio" default="$(env USE_VIO false)" description="Run RealSense camera + Basalt VIO (set via USE_VIO in .env)" />

    <let name="map_path" value="$(env MAPS_DIR)/$(var map)" />

    <!-- ON PHYSICAL SYSTEM -->
    <node pkg="global_planner" exec="mapping_node" name="mapping_node" output="screen" emulate_tty="true">
        <param from="$(find-pkg-share stack_master)/config/global_planner/mapping.yaml" />
        <param name="map_path" value="$(var map_path)" />
    </node>

    <!-- launch teleop + sensors -->
    <include file="$(find-pkg-share stack_master)/launch/teleop_launch.xml">
        <arg name="racecar_version" value="$(var racecar_version)" />
        <arg name="use_vio" value="$(var use_vio)" />
    </include>

    <!-- launch SE -->
    <include file="$(find-pkg-share state_estimation)/launch/state_estimation_launch.xml">
        <arg name="racecar_version" value="$(var racecar_version)" />
        <arg name="mapping_bool" value="True" />
        <arg name="map" value="$(var map)" />
        <arg name="use_sim_time" value="False" />
        <arg name="use_vio" value="$(var use_vio)" />
    </include>

    <!-- launch global parameter node -->
    <node pkg="stack_master" name="global_parameters" exec="global_parameter_node">
        <param name="racecar_version" value="$(var racecar_version)" />
        <param name="floor" value="$(var floor)" />
        <param name="sim" value="false" />
        <param name="map_path" value="$(var map_path)" />
        <param name="use_sim_time" value="false" />
    </node>




</launch>
