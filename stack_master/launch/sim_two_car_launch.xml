<launch>
  <arg name="map_name" default="latest" />
  <arg name="ego_planner" default="spliner" description="spliner / ibr / none" />
  <arg name="opp_planner" default="spliner"    description="spliner / ibr / gb / none" />
  <arg name="ego_ctrl" default="PP" />
  <arg name="opp_ctrl" default="PP" />
  <arg name="opponent_source" default="perception" description="gt / perception" />
  <arg name="ego_speed_scale" default="0.5" />
  <arg name="opp_speed_scale" default="0.5" />
  <arg name="ego_s" default="0.0" description="ego start along the raceline [m]" />
  <arg name="ego_d" default="0.0" description="ego offset from the raceline, left is positive [m]" />
  <arg name="opp_s" default="2.0" description="opp start along the raceline [m]" />
  <arg name="opp_d" default="0.0" description="opp offset from the raceline, left is positive [m]" />
  <arg name="opp_record_path" default="" />
  <arg name="ego_record_path" default="" />
  <arg name="ego_n_game_iterations" default="4" />
  <arg name="opp_n_game_iterations" default="4" />
  <arg name="headless" default="false" />
  <arg name="ego_speed_limit" default="0.0" />
  <arg name="opp_speed_limit" default="0.0" />
  <arg name="flat_speed" default="0.0" />


  <let name="map_path" value="$(find-pkg-share stack_master)/maps/$(var map_name)" />

  <!-- shared -->
  <include file="$(find-pkg-share f1tenth_gym_ros)/launch/gym_bridge_launch.py">
    <arg name="map_yaml_path" value="$(var map_path)/$(var map_name).yaml" />
    <arg name="sim_config" value="$(find-pkg-share stack_master)/config/SIM/sim_two_car.yaml" />
    <arg name="ego_s" value="$(var ego_s)" />
    <arg name="ego_d" value="$(var ego_d)" />
    <arg name="opp_s" value="$(var opp_s)" />
    <arg name="headless" value="$(var headless)" />
    <arg name="opp_d" value="$(var opp_d)" />

  </include>
  <node pkg="stack_master" name="global_parameters" exec="global_parameter_node">
    <param name="racecar_version" value="SIM" />
    <param name="sim" value="True" />
    <param name="map_path" value="$(var map_path)" />
  </node>
  <include file="$(find-pkg-share global_planner)/launch/global_trajectory_publisher_launch.xml">
    <arg name="map_path" value="$(var map_path)" />
  </include>
  <node pkg="sector_tuner" name="sector_tuner" exec="sector_tuner">
    <param name="map_name" value="$(var map_name)" />
    <param from="$(var map_path)/speed_scaling.yaml" />
    <param name="flat_speed" value="$(var flat_speed)" />
  </node>

  <!-- per car -->
  <include file="$(find-pkg-share stack_master)/launch/car_stack_launch.xml">
    <arg name="ns" value="ego" />
    <arg name="speed_scale" value="$(var ego_speed_scale)" />
    <arg name="planner" value="$(var ego_planner)" />
    <arg name="ctrl_algo" value="$(var ego_ctrl)" />
    <arg name="map_name" value="$(var map_name)" />
    <arg name="opponent_source" value="$(var opponent_source)" />
    <arg name="opp_ns" value="opp" />
    <arg name="rival_speed_scale" value="$(var opp_speed_scale)" />
    <arg name="record_path" value="$(var ego_record_path)" />
    <arg name="n_game_iterations" value="$(var ego_n_game_iterations)" />
    <arg name="speed_limit" value="$(var ego_speed_limit)" />
    <arg name="rival_speed_limit" value="$(var opp_speed_limit)" />


  </include>
  <include file="$(find-pkg-share stack_master)/launch/car_stack_launch.xml">
    <arg name="ns" value="opp" />
    <arg name="planner" value="$(var opp_planner)" />
    <arg name="speed_scale" value="$(var opp_speed_scale)" />
    <arg name="ctrl_algo" value="$(var opp_ctrl)" />
    <arg name="map_name" value="$(var map_name)" />
    <arg name="opponent_source" value="$(var opponent_source)" />
    <arg name="opp_ns" value="ego" />
    <arg name="rival_speed_scale" value="$(var ego_speed_scale)" />
    <arg name="record_path" value="$(var opp_record_path)" />
    <arg name="n_game_iterations" value="$(var opp_n_game_iterations)" />
    <arg name="speed_limit" value="$(var opp_speed_limit)" />
    <arg name="rival_speed_limit" value="$(var ego_speed_limit)" />
  </include>
</launch>
