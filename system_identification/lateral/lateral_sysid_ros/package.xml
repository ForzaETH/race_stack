<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lateral_sysid_ros</name>
  <version>0.1.0</version>
  <description>ROS 2 nodes and tools around on_track_sysid: on-track and steady-state tire identification, steering LUT generation</description>
  <maintainer email="edoardo.ghignone@pbl.ee.ethz.ch">ForzaETH</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>ackermann_msgs</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>forza_config</exec_depend>
  <exec_depend>forza_config_ros</exec_depend>
  <exec_depend>on_track_sysid</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <!-- on_track_node also needs torch: pip install torch -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
