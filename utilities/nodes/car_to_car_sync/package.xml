<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>car_to_car_sync</name>
  <version>0.0.0</version>
  <description>Stream opponent car topics across ROS domains and publish them as ground-truth obstacles</description>
  <maintainer email="maurice.brunner@pbl.ee.ethz.ch">Maurice Brunner</maintainer>
  <license>Apache License 2.0</license>

  <exec_depend>ros2launch</exec_depend>
  <depend>rclpy</depend>
  <depend>rosidl_runtime_py</depend>
  <depend>nav_msgs</depend>
  <depend>f110_msgs</depend>
  <exec_depend>stack_master</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
